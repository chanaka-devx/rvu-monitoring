NODE_ENV=development
DB_PORT=5432
POSTGRES_USER=rvu
POSTGRES_PASSWORD=rvu
POSTGRES_DB=rvu_monitoring
DOCKER_HOST=tcp://localhost:2375
# Local development credentials only; replace in deployed environments.
DATABASE_URL=postgres://rvu:rvu@localhost:5432/rvu_monitoring
APP_DB_PASSWORD=rvu_app_dev_only
APP_DATABASE_URL=postgres://rvu_app:rvu_app_dev_only@localhost:5432/rvu_monitoring
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
LOG_LEVEL=info
OUTBOX_DISPATCHER=on
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=60000
PORT=3000
